#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
cd "$repo_root"

if ! command -v mise >/dev/null 2>&1; then
	printf '%s\n' 'mise is missing; rerun .agents/setup.' >&2
	exit 1
fi
eval "$(mise activate bash --shims)"

for command_name in bun coderabbit greptile mise node npm openskills python pytest shellcheck shfmt uv; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		printf '%s is missing; rerun .agents/setup.\n' "$command_name" >&2
		exit 1
	fi
done
mise where python@3.12 >/dev/null

printf '%s\n' 'Orb resume checks complete.'
